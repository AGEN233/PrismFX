config ENABLE_ARGB
    bool "Enable Addressable RGB"
    default y

menu "Addressable RGB Driver Configuration"
    depends on ENABLE_ARGB

    choice ARGB_TYPE
        prompt "ARGB TYPE"
        default ARGB_TYPE_WS2812B_SPI
        config ARGB_TYPE_WS2812B_SPI
            bool "WS2812B (SPI)"
        config ARGB_TYPE_WS2812B_RMT
            bool "WS2812B(RMT)"
        config ARGB_TYPE_SK6812
            bool "SK6812"
        
    endchoice

    config WS2812B_STACK_SIZE
        int "WS2812B SPI Task Stack Size (bytes)"
        default 1024
        range 256 8192
        depends on ARGB_TYPE_WS2812B_SPI || ARGB_TYPE_WS2812B_RMT

    config ARGB_OUT_PIN
        int "ARGB OUT_PIN"
        default 2
        range 0 39
        depends on (ARGB_TYPE_WS2812B_SPI || ARGB_TYPE_SK6812 || ARGB_TYPE_WS2812B_RMT)

    config LED_COUNT_MAX
        int "LED COUNT MAX"
        default 1024
endmenu
